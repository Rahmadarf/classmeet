# Dipakai aplikasi (browser + server). Kunci publishable/anon; keamanan dijaga RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya untuk Cloudflare Tunnel: nama host publik aplikasi (tanpa https://), diizinkan Next dev. Lihat deploy/supabase/README.md.
# CLASSMEET_PUBLIC_HOSTS=app.contoh.com
# Alamat Supabase untuk kode SERVER saja (proxy, server action, komponen server). Isi bila Next dan Supabase satu mesin
# (mis. laptop dengan tunnel): http://localhost:8000. Server tidak lagi memutar lewat internet dan Cloudflare (±9x lebih cepat per
# query). Kosong = memakai NEXT_PUBLIC_SUPABASE_URL. Browser tetap memakai alamat publik. Gateway harus terbuka di port 8000 (mode --tunnel/--server).
# SUPABASE_INTERNAL_URL=http://localhost:8000

# HANYA untuk skrip panitia di laptop lokal (scripts/*.ts). Jangan pernah dimasukkan ke
# .env.local milik aplikasi, container, repo, atau log. Berikan lewat shell saat menjalankan skrip:
#   SUPABASE_SERVICE_ROLE_KEY=... npm run seed
# SUPABASE_SERVICE_ROLE_KEY=   (juga dibaca server untuk aksi admin "Tambah tim" dan "Tambah pos"; HANYA di server, tanpa NEXT_PUBLIC)

# Layar publik (/display) tanpa login: akun peran `display` yang dimasuki OTOMATIS oleh server saat halamannya dibuka
# tanpa sesi. Hanya dibaca di server (jangan diberi awalan NEXT_PUBLIC_). Kosongkan untuk mewajibkan login.
# Siapa pun yang bisa membuka /display lalu mendapat akses baca peran `display` (peringkat, pasar, pos, berita).
# PIN penjaga pos sebelum menekan Kirim di form hadiah (4-8 angka). Bila kosong/tidak valid: 12345.
# GUARD_PIN=12345

# DISPLAY_USERNAME=display
# DISPLAY_PASSWORD=
