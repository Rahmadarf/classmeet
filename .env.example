# Dipakai aplikasi (browser + server). Kunci publishable/anon; keamanan dijaga RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# HANYA untuk skrip panitia di laptop lokal (scripts/*.ts). Jangan pernah dimasukkan ke
# .env.local milik aplikasi, container, repo, atau log. Berikan lewat shell saat menjalankan skrip:
#   SUPABASE_SERVICE_ROLE_KEY=... npm run seed
# SUPABASE_SERVICE_ROLE_KEY=

# Layar publik (/display) tanpa login: akun peran `display` yang dimasuki OTOMATIS oleh server saat halamannya dibuka
# tanpa sesi. Hanya dibaca di server (jangan diberi awalan NEXT_PUBLIC_). Kosongkan untuk mewajibkan login.
# Siapa pun yang bisa membuka /display lalu mendapat akses baca peran `display` (peringkat, pasar, pos, berita).
# DISPLAY_USERNAME=display
# DISPLAY_PASSWORD=
