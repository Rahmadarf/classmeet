# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# keluaran skrip seed (memuat kredensial akun uji; jangan di-commit)
/scripts/.seed-output.local.json
# kartu QR tim hasil print-qr.ts (memuat kredensial; jangan di-commit)
/scripts/.qr-output.local/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# disalin dari node_modules oleh scripts/copy-zxing-wasm.mjs
/public/vendor/

# Playwright MCP (artefak uji lokal)
/.playwright-mcp/

# Supabase self-hosted (Docker): berkas unduhan resmi + .env berisi rahasia, dan dump DB berisi data sensitif
/deploy/supabase/stack/
/deploy/supabase/dump/

# daftar kredensial lokal (kata sandi, PIN, pascode): JANGAN di-commit
/KREDENSIAL.local.md

# konfigurasi SFTP (memuat kata sandi server; jangan di-commit)
/.vscode/sftp.json

# paket migrasi database (berisi hash kata sandi akun; jangan di-commit)
/deploy/supabase/bundle/

# isi berita (teks, efek, event): tidak di-commit
/docs/berita-650/
/docs/14-kumpulan-berita.md
/scripts/data/news-pool.json
/scripts/data/news-pool.auto.json
